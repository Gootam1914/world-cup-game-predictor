# Copy this file to `.env` and fill in your keys.
# These are ONLY needed for the optional live modules (current rosters + gap-fill).
# The StatsBomb-trained model and UI work fully WITHOUT any keys.

# API-Football (https://www.api-football.com/) -- used by src/roster_fetch.py
# for current national-team squads.
API_FOOTBALL_KEY=

# football-data.org (https://www.football-data.org/) -- used by
# src/football_data_api.py to append recent international fixtures/results
# that StatsBomb has not published yet.
FOOTBALL_DATA_ORG_KEY=

# Where to cache the large StatsBomb open-data git clone + downloaded events.
# Defaults to ./data/raw if unset.
SGP_DATA_DIR=
